{
  "name": "minerva",
  "version": "4.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "description": "Minerva — an integrated knowledge management environment",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgriffith/ide-for-thought.git"
  },
  "main": ".vite/build/main.cjs",
  "bin": {
    "minerva": ".vite/build/cli.js"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "node scripts/build-core-plugins.mjs && electron-forge start",
    "core-plugins:build": "node scripts/build-core-plugins.mjs",
    "cli:build": "vite build --config vite.cli.config.mts && chmod +x .vite/build/cli.js",
    "cli": "pnpm cli:build && node .vite/build/cli.js",
    "build": "electron-forge make",
    "build:release": "MINERVA_RELEASE=1 electron-forge make",
    "package": "electron-forge package",
    "release:tag": "node scripts/tag-release.mjs",
    "worktrees:prune": "node scripts/prune-worktrees.mjs",
    "lint": "node scripts/lint.mjs",
    "lint:seq": "tsc --noEmit && svelte-check --threshold error && eslint .",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "lint:fonts": "! grep -rnE \"SF Mono|Fira Code|SFMono-Regular|'Cascadia\" src/renderer --include=*.svelte --include=*.ts | grep -v 'appearance/settings.ts'",
    "pretest": "node scripts/fetch-embedding-model.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run --config vitest.bench.config.ts",
    "bench:json": "vitest bench --run --config vitest.bench.config.ts --reporter=json --outputFile=bench-results.json",
    "bench:check": "pnpm bench:json && node scripts/bench-check.mjs --current bench-results.json",
    "bench:baseline": "pnpm bench:json && node scripts/bench-check.mjs --current bench-results.json --update",
    "precoverage": "node scripts/fetch-embedding-model.mjs",
    "coverage": "vitest run --coverage",
    "build:e2e": "NODE_OPTIONS=--max-old-space-size=4096 electron-forge package",
    "test:e2e": "pnpm build:e2e && playwright test",
    "build:clipper": "node clipper/build.mjs",
    "package:clipper": "node clipper/package.mjs",
    "typecheck:clipper": "tsc -p clipper/tsconfig.json --noEmit",
    "fetch:model": "node scripts/fetch-embedding-model.mjs",
    "fetch:help-corpus": "vite-node scripts/build-help-corpus.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "docs:screenshots": "playwright test --config playwright.docs-screenshots.config.ts",
    "check:docs": "node scripts/build-docs.mjs --check",
    "check:ruleset": "node scripts/check-branch-ruleset.mjs",
    "sample:events": "node scripts/make-events-thoughtbase.mjs",
    "predev": "node scripts/prep.mjs",
    "prebuild": "node scripts/prep.mjs",
    "prebuild:release": "node scripts/prep.mjs",
    "prebuild:e2e": "node scripts/prep.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@aws-sdk/client-s3": "^3.1163.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/legacy-modes": "^6.5.5",
    "@comunica/query-sparql-rdfjs": "^5.4.1",
    "@duckdb/node-api": "1.5.3-r.3",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@google/genai": "^3.0.0",
    "@huggingface/transformers": "^4.3.2",
    "@mozilla/readability": "^0.6.0",
    "@retorquere/bibtex-parser": "13.0.7",
    "@traqula/parser-sparql-1-1": "1.4.0",
    "@types/markdown-it-footnote": "^3.0.4",
    "chart.js": "^4.6.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chokidar": "^6.0.0",
    "citeproc": "^2.4.63",
    "cross-spawn": "^7.0.6",
    "cytoscape": "^3.34.4",
    "d3-force": "^3.0.1",
    "d3-hierarchy": "^3.1.3",
    "d3-time": "3.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "isomorphic-git": "^1.44.11",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "linkedom": "^0.18.15",
    "maplibre-gl": "^6.16.0",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^12.3.0",
    "minisearch": "^7.2.0",
    "n3": "^2.13.12",
    "onnxruntime-web": "^1.31.1",
    "openai": "^7.53.0",
    "pdfjs-dist": "^6.5.438",
    "rdflib": "^2.4.1",
    "semver": "^7.8.6",
    "shacl-engine": "1.1.3",
    "sql-formatter": "^15.9.0",
    "sql.js": "^1.15.2",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0",
    "tslib": "^2.9.1",
    "turndown": "^7.2.5",
    "unpdf": "^2.1.0",
    "update-electron-app": "^3.3.0",
    "vega-embed": "^7.3.0",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron-forge/shared-types": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/chrome": "^0.3.7",
    "@types/cross-spawn": "^6.0.6",
    "@types/d3-force": "^3.0.10",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-time": "3.0.4",
    "@types/markdown-it": "^14.2.0",
    "@types/n3": "^1.26.6",
    "@types/semver": "^7.8.0",
    "@types/turndown": "^5.0.6",
    "@types/yauzl": "^3.4.0",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.0",
    "codemirror": "^6.0.2",
    "dependency-cruiser": "^18.7.2",
    "electron": "^45.2.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.0",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "highlight.js": "^11.12.0",
    "jsdom": "^31.0.0",
    "markdown-it": "^15.0.3",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-node": "6.0.0",
    "vitest": "^5.1.0"
  }
}
