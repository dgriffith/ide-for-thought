{
  "name": "minerva",
  "version": "2.0.2",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "description": "Minerva — an integrated knowledge management environment",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgriffith/ide-for-thought.git"
  },
  "main": ".vite/build/main.js",
  "bin": {
    "minerva": ".vite/build/cli.js"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "electron-forge start",
    "cli:build": "vite build --config vite.cli.config.mts && chmod +x .vite/build/cli.js",
    "cli": "pnpm cli:build && node .vite/build/cli.js",
    "build": "electron-forge make",
    "package": "electron-forge package",
    "release:tag": "node scripts/tag-release.mjs",
    "lint": "node scripts/lint.mjs",
    "lint:seq": "tsc --noEmit && svelte-check --threshold error && eslint .",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "lint:fonts": "! grep -rnE \"SF Mono|Fira Code|SFMono-Regular|'Cascadia\" src/renderer --include=*.svelte --include=*.ts | grep -v 'appearance/settings.ts'",
    "pretest": "node scripts/fetch-embedding-model.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run --config vitest.bench.config.ts",
    "bench:json": "vitest bench --run --config vitest.bench.config.ts --reporter=json --outputFile=bench-results.json",
    "bench:check": "pnpm bench:json && node scripts/bench-check.mjs --current bench-results.json",
    "bench:baseline": "pnpm bench:json && node scripts/bench-check.mjs --current bench-results.json --update",
    "precoverage": "node scripts/fetch-embedding-model.mjs",
    "coverage": "vitest run --coverage",
    "build:e2e": "NODE_OPTIONS=--max-old-space-size=4096 electron-forge package",
    "test:e2e": "pnpm build:e2e && playwright test",
    "build:clipper": "node clipper/build.mjs",
    "package:clipper": "node clipper/package.mjs",
    "typecheck:clipper": "tsc -p clipper/tsconfig.json --noEmit",
    "fetch:model": "node scripts/fetch-embedding-model.mjs",
    "fetch:help-corpus": "vite-node scripts/build-help-corpus.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "check:docs": "node scripts/build-docs.mjs --check",
    "predev": "node scripts/prep.mjs",
    "prebuild": "node scripts/prep.mjs",
    "prebuild:e2e": "node scripts/prep.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@aws-sdk/client-s3": "^3.1135.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/legacy-modes": "^6.5.4",
    "@comunica/query-sparql-rdfjs": "^5.4.1",
    "@duckdb/node-api": "1.5.3-r.3",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@google/genai": "^2.23.0",
    "@huggingface/transformers": "^4.3.0",
    "@mozilla/readability": "^0.6.0",
    "@retorquere/bibtex-parser": "^11.0.0",
    "@types/markdown-it-footnote": "^3.0.4",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chokidar": "^5.0.0",
    "citeproc": "^2.4.63",
    "cytoscape": "^3.34.3",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.15",
    "isomorphic-git": "^1.42.2",
    "jszip": "^3.10.2",
    "katex": "^0.18.7",
    "linkedom": "^0.18.13",
    "maplibre-gl": "^6.10.0",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^11.17.2",
    "minisearch": "^7.2.0",
    "n3": "^2.7.12",
    "onnxruntime-web": "^1.30.0",
    "openai": "^7.18.0",
    "pdfjs-dist": "^6.3.289",
    "rdflib": "^2.4.0",
    "sql-formatter": "^15.8.2",
    "sql.js": "^1.14.2",
    "tesseract.js": "^7.0.0",
    "tslib": "^2.8.1",
    "turndown": "^7.2.4",
    "unpdf": "^1.8.1",
    "update-electron-app": "^3.3.0",
    "vega-embed": "^7.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/chrome": "^0.3.0",
    "@types/markdown-it": "^14.2.0",
    "@types/n3": "^1.26.4",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^5.0.1",
    "axe-core": "^4.13.0",
    "codemirror": "^6.0.2",
    "dependency-cruiser": "^18.3.1",
    "electron": "^44.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.1.0",
    "markdown-it": "^15.0.2",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-node": "6.0.0",
    "vitest": "^5.0.1"
  }
}
