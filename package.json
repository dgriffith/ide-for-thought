{
  "name": "minerva",
  "version": "2.0.0-alpha.1",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "description": "Minerva — an integrated knowledge management environment",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgriffith/ide-for-thought.git"
  },
  "main": ".vite/build/main.js",
  "bin": {
    "minerva": ".vite/build/cli.js"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "electron-forge start",
    "cli:build": "vite build --config vite.cli.config.mts && chmod +x .vite/build/cli.js",
    "cli": "pnpm cli:build && node .vite/build/cli.js",
    "build": "electron-forge make",
    "package": "electron-forge package",
    "release:tag": "node scripts/tag-release.mjs",
    "lint": "node scripts/lint.mjs",
    "lint:seq": "tsc --noEmit && svelte-check --threshold error && eslint .",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "lint:fonts": "! grep -rnE \"SF Mono|Fira Code|SFMono-Regular|'Cascadia\" src/renderer --include=*.svelte --include=*.ts | grep -v 'appearance/settings.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run --config vitest.bench.config.ts",
    "bench:json": "vitest bench --run --config vitest.bench.config.ts --outputJson bench-results.json",
    "bench:check": "pnpm bench:json && node scripts/bench-check.mjs --current bench-results.json",
    "bench:baseline": "pnpm bench:json && node scripts/bench-check.mjs --current bench-results.json --update",
    "coverage": "vitest run --coverage --test-timeout=30000",
    "build:e2e": "NODE_OPTIONS=--max-old-space-size=4096 electron-forge package",
    "test:e2e": "pnpm build:e2e && playwright test",
    "build:clipper": "node clipper/build.mjs",
    "package:clipper": "node clipper/package.mjs",
    "typecheck:clipper": "tsc -p clipper/tsconfig.json --noEmit",
    "fetch:model": "node scripts/fetch-embedding-model.mjs",
    "fetch:help-corpus": "vite-node scripts/build-help-corpus.mjs",
    "predev": "node scripts/fetch-embedding-model.mjs && vite-node scripts/build-help-corpus.mjs",
    "prebuild": "node scripts/fetch-embedding-model.mjs && vite-node scripts/build-help-corpus.mjs",
    "prebuild:e2e": "node scripts/fetch-embedding-model.mjs && vite-node scripts/build-help-corpus.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.1105.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/legacy-modes": "^6.5.3",
    "@comunica/query-sparql-rdfjs": "^5.3.0",
    "@duckdb/node-api": "1.5.3-r.3",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@google/genai": "^2.16.0",
    "@huggingface/transformers": "^4.2.0",
    "@mozilla/readability": "^0.6.0",
    "@retorquere/bibtex-parser": "^9.0.29",
    "@types/markdown-it-footnote": "^3.0.4",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chokidar": "^5.0.0",
    "citeproc": "^2.4.63",
    "cytoscape": "^3.34.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.13",
    "isomorphic-git": "^1.40.3",
    "jszip": "^3.10.1",
    "katex": "^0.18.1",
    "linkedom": "^0.18.13",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^11.16.1",
    "minisearch": "^7.2.0",
    "n3": "^2.2.0",
    "onnxruntime-web": "^1.27.0",
    "openai": "^7.4.0",
    "pdfjs-dist": "^6.2.108",
    "rdflib": "^2.4.0",
    "sql-formatter": "^15.8.2",
    "sql.js": "^1.14.1",
    "tesseract.js": "^7.0.0",
    "tslib": "^2.8.1",
    "turndown": "^7.2.4",
    "unpdf": "^1.8.0",
    "update-electron-app": "^3.3.0",
    "vega-embed": "^7.1.0",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "fs-xattr",
      "macos-alias"
    ],
    "overrides": {
      "@codemirror/view": "6.43.1",
      "@codemirror/state": "6.7.1",
      "@codemirror/language": "6.12.4",
      "d3-path": "^3.1.0",
      "parse-url": ">=8.1.0",
      "tmp": ">=0.2.6",
      "gry": ">=6.0.0",
      "sharp": ">=0.35.0",
      "adm-zip": ">=0.6.0"
    }
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/chrome": "^0.2.5",
    "@types/markdown-it": "^14.1.2",
    "@types/n3": "^1.26.1",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.13.0",
    "codemirror": "^6.0.2",
    "electron": "^43.3.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.2",
    "highlight.js": "^11.11.1",
    "jsdom": "^30.0.1",
    "markdown-it": "^15.0.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "svelte-eslint-parser": "^1.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-node": "6.0.0",
    "vitest": "^4.1.10"
  }
}
