{
  "name": "minerva",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "description": "Minerva — an integrated knowledge management environment",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "electron-forge start",
    "build": "electron-forge make",
    "package": "electron-forge package",
    "lint": "tsc --noEmit && svelte-check --threshold error && eslint .",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "build:e2e": "NODE_OPTIONS=--max-old-space-size=4096 electron-forge package",
    "test:e2e": "pnpm build:e2e && playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/legacy-modes": "^6.5.3",
    "@comunica/query-sparql-rdfjs": "^5.2.3",
    "@duckdb/node-api": "1.5.2-r.1",
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-serif": "^5.2.7",
    "@mozilla/readability": "^0.6.0",
    "@retorquere/bibtex-parser": "^9.0.29",
    "@types/markdown-it-footnote": "^3.0.4",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chokidar": "^5.0.0",
    "citeproc": "^2.4.63",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.9",
    "isomorphic-git": "^1.38.4",
    "jszip": "^3.10.1",
    "katex": "^0.17.0",
    "linkedom": "^0.18.12",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^11.15.0",
    "minisearch": "^7.2.0",
    "n3": "^2.0.3",
    "pdfjs-dist": "^6.0.227",
    "rdflib": "^2.3.9",
    "sql-formatter": "^15.8.1",
    "tesseract.js": "^7.0.0",
    "tslib": "^2.8.1",
    "turndown": "^7.2.4",
    "unpdf": "^1.6.2",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "fs-xattr",
      "macos-alias"
    ],
    "overrides": {
      "@codemirror/view": "6.43.1"
    }
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/svelte": "^5.3.1",
    "@types/markdown-it": "^14.1.2",
    "@types/n3": "^1.26.1",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^4.1.8",
    "codemirror": "^6.0.2",
    "electron": "^42.4.0",
    "eslint": "^10.4.1",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "happy-dom": "^20.10.2",
    "highlight.js": "^11.11.1",
    "jsdom": "^29.1.1",
    "markdown-it": "^14.2.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "svelte-eslint-parser": "^1.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.8"
  }
}
