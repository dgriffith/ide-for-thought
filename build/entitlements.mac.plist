<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- V8 / Electron need executable JIT memory under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- No com.apple.security.cs.disable-library-validation (#2565). It was here
       for DuckDB's prebuilt duckdb.node / libduckdb.dylib on the theory that
       they ship unsigned by our team — but osx-sign signs every Mach-O in the
       bundle, app.asar.unpacked included, with the team identity: in the
       v3.0.0 release both carry TeamIdentifier=ZC2MK8M828, which is exactly
       what library validation accepts. With it, Minerva would load ANY
       unsigned dylib it was pointed at. A new native dependency is signed the
       same way; release.yml's signed smoke boot opens a DuckDB project, so a
       binary that fails validation stops the release, not a user. -->
  <!-- Microphone access for local dictation (#voice). Required under the
       hardened runtime for getUserMedia({audio}) to reach the input device. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
